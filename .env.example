# Local Node server only. Never commit a real key.
GEMINI_API_KEY=

# Comma-separated browser origins allowed to call the local Node API.
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
PORT=3000

# GitHub Pages production build: set this to the deployed Worker origin.
# Example: https://earthquake-cloud-api.example.workers.dev
VITE_API_BASE_URL=

# Optional. Set after creating a Cloudflare Turnstile widget.
VITE_TURNSTILE_SITE_KEY=
